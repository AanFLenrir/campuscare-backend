# .env.example — PETRIVA (Pet Care Management System)
# Salin file ini menjadi .env dan sesuaikan nilainya:
# Copy-Item .env.example .env

# Database PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=petriva
DB_SSLMODE=disable

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_petriva_2026
JWT_EXPIRE_HOUR=24

# Server Configuration
APP_PORT=3000
APP_ENV=development
