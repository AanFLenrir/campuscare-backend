# .env.example — Salin file ini menjadi .env dan isi nilainya

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=campuscare
DB_SSLMODE=disable

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY_HOURS=24

# Server
APP_PORT=3000
APP_ENV=development

